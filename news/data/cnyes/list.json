top:30px\"><table><tbody><tr><td style=\"text-align: left;\"><em>預估值</em></td><td style=\"text-align: right;\"><em>2026年</em></td><td style=\"text-align: right;\"><em>2027年</em></td><td style=\"text-align: right;\"><em>2028年</em></td><td style=\"text-align: right;\"><em>2029年</em></td></tr><tr><td style=\"text-align: left;\">最高值</td><td style=\"text-align: right;\">670.16億</td><td style=\"text-align: right;\">715.46億</td><td style=\"text-align: right;\">744.97億</td><td style=\"text-align: right;\">785.36億</td></tr><tr><td style=\"text-align: left;\">最低值</td><td style=\"text-align: right;\">655.69億</td><td style=\"text-align: right;\">655.97億</td><td style=\"text-align: right;\">702.65億</td><td style=\"text-align: right;\">755.00億</td></tr><tr><td style=\"text-align: left;\">平均值</td><td style=\"text-align: right;\">664.76億</td><td style=\"text-align: right;\">696.24億</td><td style=\"text-align: right;\">730.44億</td><td style=\"text-align: right;\">770.18億</td></tr><tr><td style=\"text-align: left;\">中位數</td><td style=\"text-align: right;\">665.08億</td><td style=\"text-align: right;\">698.24億</td><td style=\"text-align: right;\">736.23億</td><td style=\"text-align: right;\">770.18億</td></tr></tbody></table></section><section style=\"margin-top:30px\"><p><em>歷史獲利表現</em></p></section><section style=\"margin-top:30px\"><table><tbody><tr><td style=\"text-align: left;\">項目</td><td style=\"text-align: right;\"><em>2021年</em></td><td style=\"text-align: right;\"><em>2022年</em></td><td style=\"text-align: right;\"><em>2023年</em></td><td style=\"text-align: right;\"><em>2024年</em></td><td style=\"text-align: right;\"><em>2025年</em></td></tr><tr><td style=\"text-align: left;\">EPS</td><td style=\"text-align: right;\">0.44</td><td style=\"text-align: right;\">2.06</td><td style=\"text-align: right;\">7.17</td><td style=\"text-align: right;\">5.33</td><td style=\"text-align: right;\">7.66</td></tr><tr><td style=\"text-align: left;\">營業收入</td><td style=\"text-align: right;\">298.99