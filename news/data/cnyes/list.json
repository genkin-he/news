n: right;\">1,248.14億</td><td style=\"text-align: right;\">1,414.61億</td><td style=\"text-align: right;\">1,422.68億</td><td style=\"text-align: right;\">1,446.43億</td></tr></tbody></table></section><section style=\"margin-top:30px\"><p>詳細資訊請看美股內頁：<br/>本田汽車(<a data-ga-click-item=\"USS:HMC:STOCK:COMMON\" data-ga-event-name=\"Click_Quote\" data-ga-section=\"News_Article_文中行情\" data-ga-target=\"news\" href=\"https://invest.cnyes.com/usstock/detail/HMC\" rel=\"noopener noreferrer\" target=\"_self\">HMC-US</a>)</p></section><section style=\"margin-top:30px\"><p>資料來源：Factset，數據僅供參考，不作為投資建議。</p></section></main>",
