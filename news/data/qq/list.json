        {
            "id": "20260805A042FJ00",
            "title": "Match Group营收未达预期，股价下跌11%",
            "image": "https://inews.gtimg.com/om_ls/OsVT7IM2S8NlxVHAYYka-7ZT1fTWzJrGQ2lTZJMM2MX8EAA_870492/0",
            "link": "https://new.qq.com/rain/a/20260805A042FJ00",
            "author": "千锤百炼",
            "pub_date": "2026-08-05 09:21:26",
            "description": "<div id=\"article-content\"></div>",
            "source": "qq",
            "kind": 1,
            "language": "zh-CN"
