6600\"></div>\n<div class=\"rule\"></div>\n<div class=\"fancy-main__button __next fancy-main-next\" style=\"border-left: 8px solid #996600\"></div>\n</div>\n</div>\n<div class=\"fancy-thumbs\">\n<div class=\"swiper-wrapper\">\n<div class=\"swiper-slide\">\n<div class=\"fancy-thumbs__image\">\n<img alt=\"影片截圖 CGTN圖片\" loading=\"lazy\" src=\"https://image.bastillepost.com/644x392/wp-content/uploads/hongkong/2026/09/screenshot_8499785_06.jpeg.webp\"/>\n</div>\n<h3 class=\"h3 fancy-thumbs__title bpcategory-special-color\">影片截圖 CGTN圖片</h3>\n</div>\n<div class=\"swiper-slide\">\n<div class=\"fancy-thumbs__image\">\n<img alt=\"影片截圖 CGTN圖片\" loading=\"lazy\" src=\"https://image.bastillepost.com/644x392/wp-content/uploads/hongkong/2026/09/screenshot_8499785_04.jpeg.webp\"/>\n</div>\n<h3 class=\"h3 fancy-thumbs__title bpcategory-special-color\">影片截圖 CGTN圖片</h3>\n</div>\n<div class=\"swiper-slide\">\n<div class=\"fancy-thumbs__image\">\n<img alt=\"影片截圖 CGTN圖片\" loading=\"lazy\" src=\"https://image.bastillepost.com/644x392/wp-content/uploads/hongkong/2026/09/screenshot_8499785_05.jpeg.webp\"/>\n</div>\n<h3 class=\"h3 fancy-thumbs__title bpcategory-special-color\">影片截圖 CGTN圖片</h3>\n</div>\n<div class=\"swiper-slide\">\n<div class=\"fancy-thumbs__image\">\n<img alt=\"影片截圖 CGTN圖片\" loading=\"lazy\" src=\"https://image.bastillepost.com/644x392/wp-content/uploads/hongkong/2026/09/screenshot_8499785_03.jpeg.webp\"/>\n</div>\n<h3 class=\"h3 fancy-thumbs__title bpcategory-special-color\">影片截圖 CGTN圖片</h3>\n</div>\n<div class=\"swiper-slide\">\n<div class=\"fancy-thumbs__image\">\n<img alt=\"影片截圖 CGTN圖片\" loading=\"lazy\" src=\"https://image.bastillepost.com/644x392/wp-content/uploads/hongkong/2026/09/screenshot_8499785_02.jpeg.webp\"/>\n</div>\n<h3 class=\"h3 fancy-thumbs__title bpcategory-special-color\">影片截圖 CGTN圖片</h3>\n</div>\n<div class=\"swiper-slide\">\n<div class=\"fancy-thumbs__image\">\n<img alt=\"影片截圖 CGTN圖片\" loading=\"lazy\" src=\"https://image.bastillepost.com/1138x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_01.jpeg.webp\"/>\n</div>\n<h3 class=\"h3 fancy-thumbs__title bpcategory-special-color\">影片截圖 CGTN圖片</h3>\n</div>\n</div>\n</div>\n</div>\n<!-- slider end -->\n<p class=\"font-size-scaler-control\" data-font=\"16\" style=\"font-weight: 400;\">撇除能源及新鮮食品，以衡量潛在物價趨勢的核心核心消費物價指數，在這次報告月份上升百分之一點九。</p>\n<p class=\"font-size-scaler-control\" data-font=\"16\" style=\"font-weight: 400;\">撇除新鮮食品的食物價格按年上升百分之二點七，較七月百分之三的升幅有所放緩。薯片及其他零食價格上漲是主要推動力之一。</p>\n<p class=\"font-size-scaler-control\" data-font=\"16\" style=\"font-weight: 400;\">能源成本方面，按年下跌百分之零點七，扭轉七月上升百分之零點六的趨勢，其中電力及汽油費用分別下跌百分之二點四及百分之二點六。</p>\n\n<p class=\"font-size-scaler-control\" data-font=\"16\" style=\"font-weight: 400;\">（CGTN）</p>\n<a class=\"image-lightbox\" data-caption=\"影片截圖 CGTN圖片\" data-fancybox=\"gallery-mainpost\" href=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_06.jpeg.webp\">\n<img alt=\"影片截圖 CGTN圖片\" src=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_06.jpeg.webp\"/>\n<p class=\"caption font-size-scaler-control\" data-font=\"14\">影片截圖 CGTN圖片</p>\n</a>\n<a class=\"image-lightbox\" data-caption=\"影片截圖 CGTN圖片\" data-fancybox=\"gallery-mainpost\" href=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_04.jpeg.webp\">\n<img alt=\"影片截圖 CGTN圖片\" src=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_04.jpeg.webp\"/>\n<p class=\"caption font-size-scaler-control\" data-font=\"14\">影片截圖 CGTN圖片</p>\n</a>\n\n<a class=\"image-lightbox\" data-caption=\"影片截圖 CGTN圖片\" data-fancybox=\"gallery-mainpost\" href=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_05.jpeg.webp\">\n<img alt=\"影片截圖 CGTN圖片\" src=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_05.jpeg.webp\"/>\n<p class=\"caption font-size-scaler-control\" data-font=\"14\">影片截圖 CGTN圖片</p>\n</a>\n<a class=\"image-lightbox\" data-caption=\"影片截圖 CGTN圖片\" data-fancybox=\"gallery-mainpost\" href=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_03.jpeg.webp\">\n<img alt=\"影片截圖 CGTN圖片\" src=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_03.jpeg.webp\"/>\n<p class=\"caption font-size-scaler-control\" data-font=\"14\">影片截圖 CGTN圖片</p>\n</a>\n\n<a class=\"image-lightbox\" data-caption=\"影片截圖 CGTN圖片\" data-fancybox=\"gallery-mainpost\" href=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_02.jpeg.webp\">\n<img alt=\"影片截圖 CGTN圖片\" src=\"https://image.bastillepost.com/1200x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_02.jpeg.webp\"/>\n<p class=\"caption font-size-scaler-control\" data-font=\"14\">影片截圖 CGTN圖片</p>\n</a>\n<a class=\"image-lightbox\" data-caption=\"影片截圖 CGTN圖片\" data-fancybox=\"gallery-mainpost\" href=\"https://image.bastillepost.com/1138x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_01.jpeg.webp\">\n<img alt=\"影片截圖 CGTN圖片\" src=\"https://image.bastillepost.com/1138x/wp-content/uploads/hongkong/2026/09/screenshot_8499785_01.jpeg.webp\"/>\n<p class=\"caption font-size-scaler-control\" data-font=\"14\">影片截圖 CGTN圖片</p>\n</a>\n</div>",
