            "description": "<div class=\"atoms\" data-component=\"blocks\"><figure class=\"mb-module-gap\"><div class=\"mx-auto w-fit max-w-full\"><img alt=\"\" class=\"rounded-lg\" height=\"541\" src=\"https://s.yimg.com/lo/mysterio/api/6b6fc4e54b4ed0daca95485da327d94aecd764766b7d5739119b154234d7ff59/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fcnyes_hk_559%2Fd4d59484fb843d974b6e63fc5389719b.jpg\" width=\"960\"/></div></figure></div>",
