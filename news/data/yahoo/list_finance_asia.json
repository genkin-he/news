            "description": "<div class=\"atoms\" data-component=\"blocks\"><figure class=\"mb-module-gap\"><div class=\"mx-auto w-fit max-w-full\"><img alt=\"\" class=\"rounded-lg\" fetchpriority=\"high\" height=\"540\" src=\"https://s.yimg.com/lo/mysterio/api/1d18dbe7dd947c19ae8e487716f110dd62fe53acb1a30ce214f67114340a47ba/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2F28hse_com_210%2F58cbdb989c30eb850bbda811068d4dfd.jpg\" width=\"960\"/></div></figure></div>",
