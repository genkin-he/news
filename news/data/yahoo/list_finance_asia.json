            "description": "<div class=\"atoms\" data-component=\"blocks\"><figure class=\"mb-module-gap\"><div class=\"mx-auto w-fit max-w-full\"><img alt=\"\" class=\"rounded-lg\" height=\"541\" src=\"https://s.yimg.com/lo/mysterio/api/1522382d7eccc434b52e344066f8e2f8d01976b70ef4f0cb76170b07cd8059fe/lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fcnyes_hk_559%2F0a34348397ecdf4a16d468ce452ba1e4.jpg\" width=\"960\"/></div></figure></div>",
