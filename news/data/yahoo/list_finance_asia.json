            "description": "<div class=\"atoms\" data-component=\"blocks\"><figure class=\"mb-module-gap\"><div class=\"mx-auto w-fit max-w-full\"><img alt=\"\" class=\"rounded-lg\" fetchpriority=\"high\" height=\"676\" src=\"https://s.yimg.com/lo/mysterio/api/287074c0da60b4ab35247f0e04f94497fd41937c6d7b4dc962875be05c697211/lightyear_networkapi/resizefill_w1200%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fko%2Fcnyes_hk_559%2F0de7ade9e311a1ddf740b1a3c774f145.jpg\" width=\"1200\"/></div></figure></div>",
