            "link": "https://hk.news.yahoo.com/costco%E7%BE%8E%E5%9C%8B10%E6%9C%88%E5%90%8C%E5%BA%97%E9%8A%B7%E5%94%AE%E5%8D%8712-6-%E9%80%99%E5%80%8B%E6%95%B8%E5%AD%97%E9%A1%AF%E7%A4%BA%E8%AD%B7%E5%9F%8E%E6%B2%B3%E6%AD%A3%E5%9C%A8%E6%93%B4%E5%A4%A7-123500002.html",
