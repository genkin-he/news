            "link": "https://hk.news.yahoo.com/ai%E9%99%B7%E5%85%A5-%E7%96%B2%E5%8B%9E%E4%BA%A4%E6%98%93-%E6%8A%95%E8%B3%87%E4%BA%BA%E5%8E%AD%E5%80%A6%E5%8F%8D%E8%A6%86%E7%88%AD%E8%AB%96%E7%A7%91%E6%8A%80%E6%89%BF%E8%AB%BE-%E5%88%86%E6%9E%90%E5%B8%AB-%E5%B8%82%E5%A0%B4%E9%9C%80%E8%A6%81%E7%87%9F%E6%94%B6%E8%AD%89%E6%98%8E-110005031.html",
